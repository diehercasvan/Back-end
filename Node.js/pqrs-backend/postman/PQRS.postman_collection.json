{
  "info": {
    "name": "PQRS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "roleId",
      "value": "6"
    },
    {
      "key": "rmpId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"admin\",\"password\":\"admin123\"}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data && b.data.token) pm.collectionVariables.set('token', b.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login juan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"juan\",\"password\":\"admin123\"}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Listar roles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/roles"
          }
        },
        {
          "name": "Detalle rol",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/roles/{{roleId}}"
          }
        },
        {
          "name": "Crear rol",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"tester\",\"description\":\"Rol de prueba\",\"is_active\":1}"
            },
            "url": "{{baseUrl}}/roles"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data && b.data.role && b.data.role.id) pm.collectionVariables.set('roleId', String(b.data.role.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar rol",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"description\":\"Rol de prueba (editado)\"}"
            },
            "url": "{{baseUrl}}/roles/{{roleId}}"
          }
        },
        {
          "name": "Eliminar rol",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/roles/{{roleId}}"
          }
        },
        {
          "name": "Matriz de permisos del rol",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/roles/{{roleId}}/permissions"
          }
        },
        {
          "name": "Asignar permiso (Dashboard/view)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"module_id\":1,\"permission_id\":1}"
            },
            "url": "{{baseUrl}}/roles/{{roleId}}/permissions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data && b.data.rmp_id) pm.collectionVariables.set('rmpId', String(b.data.rmp_id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Revocar permiso",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/roles/{{roleId}}/permissions/{{rmpId}}"
          }
        },
        {
          "name": "juan intenta listar roles (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/roles"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Listar con filtro q=juan",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/users?q=juan"
          }
        },
        {
          "name": "Detalle usuario 2",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/users/2"
          }
        },
        {
          "name": "Crear usuario (con perfil + rol)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"maria\",\n  \"email\": \"maria@pqrs.com\",\n  \"password\": \"maria123\",\n  \"role_id\": 2,\n  \"profile\": {\n    \"first_name\": \"María\",\n    \"last_name\": \"Gómez\",\n    \"document_type_id\": 1,\n    \"document_number\": \"87654321\",\n    \"phone\": \"3009876543\",\n    \"address\": \"Carrera 45 #12-34\"\n  }\n}"
            },
            "url": "{{baseUrl}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data && b.data.user && b.data.user.id) pm.collectionVariables.set('newUserId', String(b.data.user.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"maria.editada@pqrs.com\"}"
            },
            "url": "{{baseUrl}}/users/{{newUserId}}"
          }
        },
        {
          "name": "Cambiar estado a suspended",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status_id\":3}"
            },
            "url": "{{baseUrl}}/users/{{newUserId}}/status"
          }
        },
        {
          "name": "Cambiar estado a active",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status_id\":1}"
            },
            "url": "{{baseUrl}}/users/{{newUserId}}/status"
          }
        },
        {
          "name": "Cambiar password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"new_password\":\"maria456\"}"
            },
            "url": "{{baseUrl}}/users/{{newUserId}}/password"
          }
        },
        {
          "name": "Listar roles del usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/users/{{newUserId}}/roles"
          }
        },
        {
          "name": "Asignar rol manager (role_id=3)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"role_id\":3}"
            },
            "url": "{{baseUrl}}/users/{{newUserId}}/roles"
          }
        },
        {
          "name": "Revocar rol (desactivar)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/users/{{newUserId}}/roles/{{urId}}"
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/users/{{newUserId}}"
          }
        },
        {
          "name": "juan intenta listar usuarios (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/users"
          }
        }
      ]
    },

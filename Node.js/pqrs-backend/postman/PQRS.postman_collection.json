          "name": "Mi perfil (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/profiles/me"
          }
        },
        {
          "name": "Editar mi perfil (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\":\"3111111111\"}"
            },
            "url": "{{baseUrl}}/profiles/me"
          }
        },
        {
          "name": "Editar perfil del usuario 2 (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
